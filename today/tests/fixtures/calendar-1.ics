DTEND;TZID=America/New_York:20260921T093000
RRULE:FREQ=DAILY;UNTIL=20261004T235959Z
SUMMARY:Morning block
DESCRIPTION:<p>Example note for a daily block. Ends October 4.</p>
END:VEVENT
BEGIN:VEVENT
UID:priority@test
DTSTART;TZID=America/New_York:20260922T100000
DTEND;TZID=America/New_York:20260922T120000
RRULE:FREQ=WEEKLY;BYDAY=MO,TU,TH,FR
SUMMARY:Priority block
DESCRIPTION:<p>Example note for a weekly block.</p>
END:VEVENT
BEGIN:VEVENT
UID:focus@test
DTSTART;TZID=America/New_York:20260922T130000
DTEND;TZID=America/New_York:20260922T160000
RRULE:FREQ=WEEKLY;BYDAY=MO,TU,TH,FR
SUMMARY:Focus block
DESCRIPTION:<p>Example note for a focus block. Include short breaks.</p>
END:VEVENT
BEGIN:VEVENT
UID:cancelled@test
