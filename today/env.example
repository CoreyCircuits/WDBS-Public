# Copy to ~/.config/wdbs-today.env on the app host, fill in, then: chmod 600 ~/.config/wdbs-today.env
# Never commit the real file, paste it into chat, or put it in Notion.

# Google Calendar "Secret address in iCal format" for each calendar, space-separated.
# Calendar settings > (calendar) > Integrate calendar > Secret address in iCal format.
WDBS_TODAY_ICS_URLS="https://calendar.google.com/calendar/ical/.../basic.ics https://calendar.google.com/calendar/ical/.../basic.ics"

# Notion internal integration token. Can be the same integration the Sonarr bridge uses,
# but that integration has to be connected to the Main page (Tasks + Projects live there).
NOTION_TOKEN="ntn_..."

# Optional: the Money segment, read from a local Ledger-style summary service (GET /v1/summary).
# Issue a read-only token with that service's own tooling and put it below.
# Leave LEDGER_URL unset to turn Money off.
LEDGER_URL="http://127.0.0.1:8760"
LEDGER_TOKEN="ssl_wdbs_..."
